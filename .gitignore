# Dependencies across all Node apps (backend, frontend, generator)
node_modules/
package-lock.json

# Environment variables & secrets
.env
.env.local
.env.*.local

# Python & PySpark caches
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Frontend builds
dist/
build/

# Cold storage archives (avoid committing big binary parquet files)
storage-archive/*.parquet
storage-archive/*_temporary/

# Logs & Docker data
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / Editor junk
.DS_Store
Thumbs.db
.vscode/
.idea/